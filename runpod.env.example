# One job per pod. Distinct RAMSEY_JOB values own disjoint (family, cell) pairs.
# Phase 1 pods are independent after phase0 kernels. 2C ∥ 2A. Phase 3 needs 2A winners.

RAMSEY_SCALE=runpod

# Pod A — recertify Paley p≤997 (O(p) squares + closed spectrum)
# RAMSEY_JOB=1a

# Pod B — F2 Gold/Kasami n=8..12 (FWHT)
# RAMSEY_JOB=1b

# Pod C — GQ polarity W(3,q)  (R(4,t)-geom)
# RAMSEY_JOB=1c

# Pod D — Frankl–Wilson + Sidon dispersers
# RAMSEY_JOB=1d

# After phase 1:
# RAMSEY_JOB=2a   cyclotomic enum p≤10^4 (cert). 3A may only perturb these winners.
# RAMSEY_JOB=2c   circulant R(3,k) only
# RAMSEY_JOB=2b   recertify 1B/1C/1D

# After seeds:
# RAMSEY_JOB=3a   block-circulant ILS, diagonal R(k,k)
# RAMSEY_JOB=3b   circulant R(4,k)
# RAMSEY_JOB=3c   GQ scale-up
# RAMSEY_JOB=3d   F2 ANF n=13..16
